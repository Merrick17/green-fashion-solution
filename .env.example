# Root — copy to apps/api/.env and apps/web/.env.local as needed

# Database (Neon — copy pooled + direct URLs from Neon dashboard → apps/api/.env)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Redis (optional — refresh-token revocation; omit for local dev without Redis)
# REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production

# API
CORS_ORIGIN=http://localhost:3001
# Cross-origin — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3001
NODE_ENV=development

# Used in email links — must match your web deployment URL
WEB_URL=http://localhost:3001

# Web — copy to apps/web/.env.local

NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Optional — removes tldraw watermark (https://tldraw.dev)
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Fireworks AI — chat, vision, embeddings, image generation (https://fireworks.ai)
FIREWORKS_API_KEY=
FIREWORKS_MODEL_CHAT=accounts/fireworks/models/kimi-k2p6
FIREWORKS_MODEL_REASONING=accounts/fireworks/models/kimi-k2-thinking
FIREWORKS_MODEL_VISION=accounts/fireworks/models/qwen2-vl-72b-instruct
FIREWORKS_MODEL_EMBED=nomic-ai/nomic-embed-text-v1.5
FIREWORKS_MODEL_IMAGE=accounts/fireworks/models/flux-1-schnell-fp8
FIREWORKS_MODEL_CUSTOM=

AI_DEFAULT_MODEL=accounts/fireworks/models/kimi-k2p6
AI_ENABLE_IMAGE_GEN=true
AI_ENABLE_RAG=true

JWT_SECRET=change-me-in-production

# Microsoft Graph (Teams meetings)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_USER_EMAIL=

# Cloudinary (image / file storage — https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend — https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=notifications@yourdomain.com

# RAG vector dimension (must match FIREWORKS_MODEL_EMBED output — nomic-embed-text-v1.5 = 768)
EMBEDDING_DIMENSION=768

# WebSocket (defaults to API origin)
# NEXT_PUBLIC_WS_URL=http://localhost:3000
