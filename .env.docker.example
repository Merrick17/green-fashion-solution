# .env.docker.example
# Copy to .env.docker, fill in values, then: docker compose up -d --build
# NEVER commit .env.docker to git.

# ── Auth (required) ───────────────────────────────────────────────────
JWT_SECRET=change-me-must-be-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-must-be-32-chars

# ── AI — Fireworks (required for AI features) ─────────────────────────
FIREWORKS_API_KEY=
FIREWORKS_MODEL_CHAT=accounts/fireworks/models/kimi-k2p6
FIREWORKS_MODEL_REASONING=accounts/fireworks/models/kimi-k2-thinking
FIREWORKS_MODEL_VISION=accounts/fireworks/models/qwen2-vl-72b-instruct
FIREWORKS_MODEL_EMBED=nomic-ai/nomic-embed-text-v1.5
FIREWORKS_MODEL_IMAGE=accounts/fireworks/models/flux-1-schnell-fp8
AI_DEFAULT_MODEL=accounts/fireworks/models/kimi-k2p6
AI_ENABLE_IMAGE_GEN=true
AI_ENABLE_RAG=true

# ── File storage — Cloudinary (required for uploads) ─────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email — Resend (required for notifications) ───────────────────────
RESEND_API_KEY=
EMAIL_FROM=notifications@yourdomain.com

# ── Microsoft Graph — Teams meetings (optional) ───────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_USER_EMAIL=

# ── Monitoring — Sentry (optional) ───────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── tldraw license — removes watermark (optional) ────────────────────
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=
