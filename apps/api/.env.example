# Neon — pooled connection for the app runtime
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon — direct connection for Prisma migrate (non-pooler host)
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Optional — refresh-token revocation. Leave unset for local dev without Redis.
# REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=notifications@yourdomain.com

# RAG — must match Fireworks FIREWORKS_MODEL_EMBED output (nomic-ai/nomic-embed-text-v1.5 = 768)
EMBEDDING_DIMENSION=768

# Microsoft Graph (Teams meetings)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_USER_EMAIL=

# Cloudinary (required for production — all image/file uploads)
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Instrumentation (Phase 6) — structured JSON request logging. Off by default.
# Set to 'true' to emit one JSON line per HTTP request (additive to the default
# human-readable request log). Leave unset/'false' for no behavior change.
LOG_STRUCTURED=false
